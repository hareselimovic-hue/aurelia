generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Perzistencija narudžbi (CLAUDE.md TODO, 23.08.2026) — dok ovoga nije bilo, narudžbe su postojale
// samo u server logu i u emailovima, sa gubitkom pri svakom redeployu. `stavke` ostaje Json (ne
// zasebna tabela) jer se stavke nikad ne mijenjaju nezavisno od narudžbe — cijena/naziv u trenutku
// kupovine mora ostati "zamrznut" čak i ako se proizvod kasnije preimenuje ili mu se promijeni cijena.
model Narudzba {
  id            String    @id @default(cuid())
  brojNarudzbe  String    @unique
  imePrezime    String
  email         String
  telefon       String
  adresa        String
  grad          String
  postanskiBroj String    @default("")
  napomena      String?
  nacinPlacanja String
  stavke        Json
  // Zbir stavki BEZ dostave — cijenaDostave je zaseban kolona (src/lib/dostava.ts, preračunato na
  // serveru iz postanskiBroj, korisnik 27.08.2026).
  ukupnaCijena  Decimal   @db.Decimal(10, 2)
  cijenaDostave Decimal   @default(0) @db.Decimal(10, 2)
  // "nova" | "poslano" — plain string (ne Prisma enum) da ostane isti stil kao NacinPlacanja u
  // src/app/api/narudzbe/types.ts (lowercase, bez posebnog mapiranja između TS i DB vrijednosti).
  status        String    @default("nova")
  createdAt     DateTime  @default(now())
  poslanoAt     DateTime?

  @@index([createdAt])
}

// Zaliha po proizvodu (korisnik, 10.10.2026) — ručno uneseno stanje, admin-only pregled, NIJE
// povezano sa checkout/shop stranicama (korisnik eksplicitno: "ne mora to biti povezano sa
// stranicom, ni da zaustavi kupovinu"). `slug` prati `Proizvod.slug` iz src/lib/products.ts
// (statični katalog, nije u bazi) — nema FK jer products.ts nije DB tabela. Kod slanja narudžbe
// ("Označi poslano", src/app/admin/narudzbe/actions.ts) se automatski skida po stavkama; "puni
// set" proizvodi nemaju svoj red ovdje koji se skida — njihove komponente (products.ts
// `komponente` polje) se skidaju umjesto njih. `kolicina` smije biti negativna (signal da je
// prodano više nego što je uneseno, ne blokira ništa).
model Zaliha {
  slug          String   @id
  kolicina      Int      @default(0)
  azuriranoAt   DateTime @updatedAt
}
